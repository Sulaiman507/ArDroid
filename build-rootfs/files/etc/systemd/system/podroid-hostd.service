[Unit]
Description=ArDroid guest -> Android host bridge (notify/forward)
After=podroid-bootstrap.service
Before=podroid-ready.service

[Service]
Type=simple
ExecStart=/usr/local/bin/podroid-hostd
StandardOutput=append:/var/log/podroid-hostd.log
StandardError=append:/var/log/podroid-hostd.log
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
