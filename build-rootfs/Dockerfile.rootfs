# build-rootfs/Dockerfile.rootfs — ArDroid (Arch Linux ARM)

# ── Stage 1: cross-compile podroid-vsock-agent (musl-static aarch64) ────────
# Unchanged from Podroid: musl-static binaries run on any distro, including
# Arch (glibc). Uses qemu-user under the hood — no separate cross-toolchain.
FROM --platform=linux/arm64 alpine:3.24 AS vsock-builder
RUN apk add --no-cache musl-dev gcc make linux-headers
WORKDIR /work
COPY vsock-agent /work/vsock-agent
RUN cd /work/vsock-agent && make CC=gcc
COPY host-bridge /work/host-bridge
RUN cd /work/host-bridge && make CC=gcc
COPY overlay-normalize /work/overlay-normalize
RUN cd /work/overlay-normalize && make CC=gcc

# ── Stage 1b: fetch the upstream Arch Linux ARM aarch64 rootfs ──────────────
# ADD does not auto-extract remote tarballs, and `scratch` has no tar/curl,
# so download + extract in a throwaway Alpine stage, then COPY the tree.
FROM --platform=linux/arm64 alpine:3.24 AS rootfs-downloader
RUN apk add --no-cache curl
RUN curl -L -o /tmp/arch-rootfs.tar.gz \
        http://os.archlinuxarm.org/os/ArchLinuxARM-aarch64-latest.tar.gz \
    && mkdir -p /rootfs \
    && tar -xzf /tmp/arch-rootfs.tar.gz -C /rootfs \
    && rm /tmp/arch-rootfs.tar.gz

# ── Stage 2: build the Arch Linux ARM rootfs squashfs ───────────────────────
# The stage root (/) IS the Arch rootfs: pacman runs natively (aarch64 via
# --platform, emulated with qemu-user-static binfmt on x86_64 hosts — the
# same mechanism stage 1 already relies on). /build holds build inputs and
# is excluded from the squashfs.
FROM --platform=linux/arm64 scratch AS builder
COPY --from=rootfs-downloader /rootfs/ /

# Pull in the vsock-agent binaries built in stage 1.
COPY --from=vsock-builder /work/vsock-agent/podroid-vsock-agent /usr/local/bin/podroid-vsock-agent
COPY --from=vsock-builder /work/host-bridge/podroid-hostd /usr/local/bin/podroid-hostd
COPY --from=vsock-builder /work/overlay-normalize/podroid-overlay-normalize /usr/local/bin/podroid-overlay-normalize

ARG SYSTEM_VERSION=0
ENV SYSTEM_VERSION=${SYSTEM_VERSION}

COPY files /build/files
COPY build-rootfs.sh /build/build-rootfs.sh
RUN chmod +x /build/build-rootfs.sh && /build/build-rootfs.sh

RUN mksquashfs / /build/arch-rootfs.squashfs \
    -comp zstd -Xcompression-level 19 -all-root -noappend \
    -e build proc sys dev run tmp
# -e dev: devtmpfs is mounted at boot (initramfs), no device nodes ship.
# -e proc/sys/run/tmp: (re)created at boot; nothing useful ships in them.
# (No -no-xattrs: rootless podman's newuidmap/newgidmap need their
# file capabilities preserved; they're stored as security.capability xattr.)

FROM scratch AS export
COPY --from=builder /build/arch-rootfs.squashfs /arch-rootfs.squashfs
